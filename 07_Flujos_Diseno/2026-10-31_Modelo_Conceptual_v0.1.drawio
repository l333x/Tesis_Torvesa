nnectable="0" parent="c48"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c52" value="* Dato personal: vive solo en la ficha del&lt;br&gt;cliente. Nunca va al LLM (RQ-21) ni al&lt;br&gt;registro verificable (RQ-17).&lt;br&gt;El Evento nombra al cliente solo por su&lt;br&gt;código; así, borrar los datos de un&lt;br&gt;cliente (ESC-08) no rompe las huellas." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E7;strokeColor=#B87333;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="770" width="340" height="132" as="geometry"/></mxCell><mxCell id="c53" value="Dónde vive cada cosa&lt;br&gt;&lt;br&gt;■ azul: registro de solicitudes&lt;br&gt;   (TEAMSLASH, PostgreSQL)&lt;br&gt;■ cobre: bóveda (Obsidian)&lt;br&gt;■ verde: registro verificable&lt;br&gt;■ gris: cuentas de Slack y Git" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E7;strokeColor=#B87333;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1270" y="660" width="250" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>