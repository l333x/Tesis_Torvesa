<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="TO_BE_Torvesa" targetNamespace="https://github.com/l333x/Tesis_Torvesa" exporter="IA de Diego (Claude)" exporterVersion="0.1">
<!-- TO-BE v0.1 parte 3 (2-nov-2026): borrador sin validar con Torvesa. -->
<bpmn:collaboration id="Colab"><bpmn:participant id="P_tor" name="Torvesa con el sistema" processRef="Proc_P_tor"/><bpmn:textAnnotation id="Nota0"><bpmn:text>Por definir en el taller (CON-06): solo recordatorio, recordatorio más aviso a la gerencia (propuesta), o reasignación a los 30 min.</bpmn:text></bpmn:textAnnotation></bpmn:collaboration>
<bpmn:process id="Proc_P_tor" isExecutable="false"><bpmn:laneSet id="LS_P_tor"><bpmn:lane id="L_coo" name="Responsable (coordinador)"><bpmn:flowNodeRef>I_mar</bpmn:flowNodeRef><bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>T_lla</bpmn:flowNodeRef><bpmn:flowNodeRef>E_seg</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_reg" name="Registro y alertas (TEAMSLASH)"><bpmn:flowNodeRef>S_15</bpmn:flowNodeRef><bpmn:flowNodeRef>T_rec</bpmn:flowNodeRef><bpmn:flowNodeRef>T_avg</bpmn:flowNodeRef><bpmn:flowNodeRef>G_ev</bpmn:flowNodeRef><bpmn:flowNodeRef>I_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>T_ras</bpmn:flowNodeRef><bpmn:flowNodeRef>E_p1</bpmn:flowNodeRef><bpmn:flowNodeRef>S_seg</bpmn:flowNodeRef><bpmn:flowNodeRef>T_rcal</bpmn:flowNodeRef><bpmn:flowNodeRef>T_lis</bpmn:flowNodeRef><bpmn:flowNodeRef>T_rg2</bpmn:flowNodeRef><bpmn:flowNodeRef>E_baj</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_ger" name="Gerencia"><bpmn:flowNodeRef>T_reas</bpmn:flowNodeRef><bpmn:flowNodeRef>S_baj</bpmn:flowNodeRef><bpmn:flowNodeRef>T_des</bpmn:flowNodeRef><bpmn:flowNodeRef>T_re2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_ver" name="Registro verificable"></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="S_15" name="15 min sin primer contacto (viene de la parte 1)"><bpmn:timerEventDefinition id="TED1"/></bpmn:startEvent><bpmn:serviceTask id="T_rec" name="Enviar un recordatorio al responsable"><bpmn:documentation>RQ-06</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="T_avg" name="Avisar a la gerencia"><bpmn:documentation>RQ-06 · CON-06</bpmn:documentation><bpmn:dataOutputAssociation id="DA_T_avg_0"><bpmn:targetRef>DS1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:eventBasedGateway id="G_ev" name="¿Qué pasa primero?"></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="I_mar" name="El responsable marca «En contacto»"><bpmn:messageEventDefinition id="MED2"/></bpmn:intermediateCatchEvent><bpmn:endEvent id="E_ok" name="Sigue en la parte 1 (se guarda la hora)"></bpmn:endEvent><bpmn:intermediateCatchEvent id="I_t2" name="Pasan otros 15 min (por definir)"><bpmn:timerEventDefinition id="TED3"/></bpmn:intermediateCatchEvent><bpmn:userTask id="T_reas" name="Reasignar la solicitud a otra persona"><bpmn:documentation>CON-06 · por validar</bpmn:documentation></bpmn:userTask><bpmn:serviceTask id="T_ras" name="Registrar la reasignación y alertar al nuevo responsable"><bpmn:documentation>RQ-04 · RQ-02</bpmn:documentation><bpmn:dataOutputAssociation id="DA_T_ras_0"><bpmn:targetRef>DS1b</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:endEvent id="E_p1" name="Vuelve a la parte 1 (alerta)"></bpmn:endEvent><bpmn:dataStoreReference id="DS1" name="Registro de eventos"></bpmn:dataStoreReference><bpmn:dataStoreReference id="DS1b" name="Registro de eventos"></bpmn:dataStoreReference><bpmn:startEvent id="S_seg" name="Llega la fecha de seguimiento"><bpmn:timerEventDefinition id="TED4"/></bpmn:startEvent><bpmn:serviceTask id="T_rcal" name="Recordar el seguimiento (evento en Google Calendar)"><bpmn:documentation>NEC-11 (en análisis)</bpmn:documentation></bpmn:serviceTask><bpmn:userTask id="T_lla" name="Llamar al cliente y anotar la nota en la ficha"><bpmn:documentation>NEC-11</bpmn:documentation></bpmn:userTask><bpmn:endEvent id="E_seg" name="Nueva fecha si hace falta"></bpmn:endEvent><bpmn:startEvent id="S_baj" name="Un vendedor deja la empresa (ESC-09)"></bpmn:startEvent><bpmn:userTask id="T_des" name="Desactivar su cuenta"><bpmn:documentation>RQ-20</bpmn:documentation></bpmn:userTask><bpmn:serviceTask id="T_lis" name="Listar sus solicitudes abiertas"><bpmn:documentation>RQ-04</bpmn:documentation></bpmn:serviceTask><bpmn:userTask id="T_re2" name="Reasignarlas a otras personas"></bpmn:userTask><bpmn:serviceTask id="T_rg2" name="Registrar las reasignaciones y avisar a cada responsable"><bpmn:documentation>RQ-04 · RQ-15</bpmn:documentation><bpmn:dataOutputAssociation id="DA_T_rg2_0"><bpmn:targetRef>DS2</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:endEvent id="E_baj" name="Las fichas siguen en la bóveda"></bpmn:endEvent><bpmn:dataStoreReference id="DS2" name="Registro de eventos"></bpmn:dataStoreReference><bpmn:sequenceFlow id="F0" name="" sourceRef="S_15" targetRef="T_rec"/><bpmn:sequenceFlow id="F1" name="" sourceRef="T_rec" targetRef="T_avg"/><bpmn:sequenceFlow id="F2" name="" sourceRef="T_avg" targetRef="G_ev"/><bpmn:sequenceFlow id="F3" name="" sourceRef="G_ev" targetRef="I_mar"/><bpmn:sequenceFlow id="F4" name="" sourceRef="I_mar" targetRef="E_ok"/><bpmn:sequenceFlow id="F5" name="" sourceRef="G_ev" targetRef="I_t2"/><bpmn:sequenceFlow id="F6" name="" sourceRef="I_t2" targetRef="T_reas"/><bpmn:sequenceFlow id="F7" name="" sourceRef="T_reas" targetRef="T_ras"/><bpmn:sequenceFlow id="F8" name="" sourceRef="T_ras" targetRef="E_p1"/><bpmn:sequenceFlow id="F9" name="" sourceRef="S_seg" targetRef="T_rcal"/><bpmn:sequenceFlow id="F10" name="" sourceRef="T_rcal" targetRef="T_lla"/><bpmn:sequenceFlow id="F11" name="" sourceRef="T_lla" targetRef="E_seg"/><bpmn:sequenceFlow id="F12" name="" sourceRef="S_baj" targetRef="T_des"/><bpmn:sequenceFlow id="F13" name="" sourceRef="T_des" targetRef="T_lis"/><bpmn:sequenceFlow id="F14" name="" sourceRef="T_lis" targetRef="T_re2"/><bpmn:sequenceFlow id="F15" name="" sourceRef="T_re2" targetRef="T_rg2"/><bpmn:sequenceFlow id="F16" name="" sourceRef="T_rg2" targetRef="E_baj"/></bpmn:process>
