<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="TO_BE_Torvesa" targetNamespace="https://github.com/l333x/Tesis_Torvesa" exporter="IA de Diego (Claude)" exporterVersion="0.1">
<!-- TO-BE v0.1 parte 2 (2-nov-2026): borrador sin validar con Torvesa. -->
<bpmn:collaboration id="Colab"><bpmn:participant id="P_cli" name="Cliente" processRef="Proc_P_cli"/><bpmn:participant id="P_tor" name="Torvesa con el sistema" processRef="Proc_P_tor"/><bpmn:messageFlow id="M11" name="Cotización" sourceRef="T_env" targetRef="I_rec"/><bpmn:messageFlow id="M15" name="Respuesta" sourceRef="T_dec" targetRef="I_resp"/><bpmn:textAnnotation id="Nota0"><bpmn:text>El asistente manda al LLM solo códigos y campos de la plantilla, nunca nombres, teléfonos ni correos (RQ-21). Si no encuentra antecedentes, lo dice y propone solo la plantilla (ESC-03).</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Nota1"><bpmn:text>Por validar en campo: si alguien de la gerencia aprueba las cotizaciones antes de enviarlas (PEN-08). Si no, se quita esta compuerta.</bpmn:text></bpmn:textAnnotation></bpmn:collaboration>
<bpmn:process id="Proc_P_cli" isExecutable="false"><bpmn:startEvent id="S_cli" name="Espera la cotización"></bpmn:startEvent><bpmn:intermediateCatchEvent id="I_rec" name="Recibe la cotización"><bpmn:messageEventDefinition id="MED1"/></bpmn:intermediateCatchEvent><bpmn:userTask id="T_dec" name="Decide y responde (acepta o no)"></bpmn:userTask><bpmn:endEvent id="E_cli" name="Fin"></bpmn:endEvent><bpmn:sequenceFlow id="F0" name="" sourceRef="S_cli" targetRef="I_rec"/><bpmn:sequenceFlow id="F1" name="" sourceRef="I_rec" targetRef="T_dec"/><bpmn:sequenceFlow id="F2" name="" sourceRef="T_dec" targetRef="E_cli"/></bpmn:process><bpmn:process id="Proc_P_tor" isExecutable="false"><bpmn:laneSet id="LS_P_tor"><bpmn:lane id="L_coo" name="Coordinador comercial"><bpmn:flowNodeRef>T_seg</bpmn:flowNodeRef><bpmn:flowNodeRef>I_resp</bpmn:flowNodeRef><bpmn:flowNodeRef>T_cie</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_cot" name="Quien cotiza"><bpmn:flowNodeRef>S_q</bpmn:flowNodeRef><bpmn:flowNodeRef>T_pid</bpmn:flowNodeRef><bpmn:flowNodeRef>T_rev</bpmn:flowNodeRef><bpmn:flowNodeRef>G_apr</bpmn:flowNodeRef><bpmn:flowNodeRef>T_env</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_ger" name="Gerencia"><bpmn:flowNodeRef>T_apr</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_otr" name="Otro vendedor o colaborador"><bpmn:flowNodeRef>S_t</bpmn:flowNodeRef><bpmn:flowNodeRef>T_bq</bpmn:flowNodeRef><bpmn:flowNodeRef>T_res</bpmn:flowNodeRef><bpmn:flowNodeRef>E_t</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_reg" name="Registro y alertas (TEAMSLASH)"><bpmn:flowNodeRef>T_hue</bpmn:flowNodeRef><bpmn:flowNodeRef>T_ev2</bpmn:flowNodeRef><bpmn:flowNodeRef>E_tor</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_bov" name="Bóveda y asistente de IA"><bpmn:flowNodeRef>T_bus</bpmn:flowNodeRef><bpmn:flowNodeRef>T_bor</bpmn:flowNodeRef><bpmn:flowNodeRef>T_his</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_ver" name="Registro verificable"></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="S_q" name="Solicitud «En contacto» (viene de la parte 1)"></bpmn:startEvent><bpmn:userTask id="T_pid" name="Pedir un borrador al asistente desde la ficha"><bpmn:documentation>RQ-11</bpmn:documentation></bpmn:userTask><bpmn:userTask id="T_rev" name="Revisar y corregir rubros, precios y plazos"><bpmn:documentation>RQ-12</bpmn:documentation></bpmn:userTask><bpmn:exclusiveGateway id="G_apr" name="¿La gerencia aprueba antes de enviar? (PEN-08)"></bpmn:exclusiveGateway><bpmn:userTask id="T_env" name="Enviar la cotización al cliente"><bpmn:documentation>M2</bpmn:documentation></bpmn:userTask><bpmn:userTask id="T_apr" name="Aprobar la cotización"><bpmn:documentation>Por validar (PEN-08)</bpmn:documentation></bpmn:userTask><bpmn:serviceTask id="T_bus" name="Buscar la ficha, la plantilla y cotizaciones anteriores"><bpmn:documentation>RQ-09 · RQ-10</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="T_bor" name="Generar el borrador y citar los documentos usados"><bpmn:documentation>RQ-11 · RQ-21</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="T_hue" name="Guardar la huella SHA-256 y pasar a «Cotizada»"><bpmn:documentation>RQ-05 · RQ-15</bpmn:documentation><bpmn:dataOutputAssociation id="DA_T_hue_0"><bpmn:targetRef>DS</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:userTask id="T_seg" name="Poner la fecha de seguimiento"><bpmn:documentation>NEC-11 (en análisis)</bpmn:documentation></bpmn:userTask><bpmn:intermediateCatchEvent id="I_resp" name="Llega la respuesta del cliente"><bpmn:messageEventDefinition id="MED2"/></bpmn:intermediateCatchEvent><bpmn:userTask id="T_cie" name="Marcar «Ganada» o «Perdida» con motivo de la lista"><bpmn:documentation>RQ-07</bpmn:documentation></bpmn:userTask><bpmn:serviceTask id="T_ev2" name="Registrar el cierre"><bpmn:documentation>RQ-15</bpmn:documentation><bpmn:dataOutputAssociation id="DA_T_ev2_0"><bpmn:targetRef>DS2</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:endEvent id="E_tor" name="Cierre registrado"></bpmn:endEvent><bpmn:startEvent id="S_t" name="Llama un cliente y su vendedor no está"><bpmn:messageEventDefinition id="MED3"/></bpmn:startEvent><bpmn:userTask id="T_bq" name="Buscar al cliente por código, nombre o tipo de obra"><bpmn:documentation>RQ-13 · M4</bpmn:documentation></bpmn:userTask><bpmn:serviceTask id="T_his" name="Mostrar la ficha con todo el historial (también sin señal)"><bpmn:documentation>RQ-13 · RQ-14</bpmn:documentation></bpmn:serviceTask><bpmn:userTask id="T_res" name="Atender sin pedirle al cliente que repita su historia"><bpmn:documentation>M4</bpmn:documentation></bpmn:userTask><bpmn:endEvent id="E_t" name="Cliente atendido"></bpmn:endEvent><bpmn:dataStoreReference id="DS" name="Registro de eventos con huella SHA-256 (solo agregar)"></bpmn:dataStoreReference><bpmn:dataStoreReference id="DS2" name="Registro de eventos"></bpmn:dataStoreReference><bpmn:sequenceFlow id="F3" name="" sourceRef="S_q" targetRef="T_pid"/><bpmn:sequenceFlow id="F4" name="" sourceRef="T_pid" targetRef="T_bus"/><bpmn:sequenceFlow id="F5" name="" sourceRef="T_bus" targetRef="T_bor"/><bpmn:sequenceFlow id="F6" name="" sourceRef="T_bor" targetRef="T_rev"/><bpmn:sequenceFlow id="F7" name="" sourceRef="T_rev" targetRef="G_apr"/><bpmn:sequenceFlow id="F8" name="No" sourceRef="G_apr" targetRef="T_env"/><bpmn:sequenceFlow id="F9" name="Sí" sourceRef="G_apr" targetRef="T_apr"/><bpmn:sequenceFlow id="F10" name="" sourceRef="T_apr" targetRef="T_env"/><bpmn:sequenceFlow id="F12" name="" sourceRef="T_env" targetRef="T_hue"/><bpmn:sequenceFlow id="F13" name="" sourceRef="T_hue" targetRef="T_seg"/><bpmn:sequenceFlow id="F14" name="" sourceRef="T_seg" targetRef="I_resp"/><bpmn:sequenceFlow id="F16" name="" sourceRef="I_resp" targetRef="T_cie"/><bpmn:sequenceFlow id="F17" name="" sourceRef="T_cie" targetRef="T_ev2"/><bpmn:sequenceFlow id="F18" name="" sourceRef="T_ev2" targetRef="E_tor"/><bpmn:sequenceFlow id="F19" name="" sourceRef="S_t" targetRef="T_bq"/><bpmn:sequenceFlow id="F20" name="" sourceRef="T_bq" targetRef="T_his"/><bpmn:sequenceFlow id="F21" name="" sourceRef="T_his" targetRef="T_res"/><bpmn:sequenceFlow id="F22" name="" sourceRef="T_res" targetRef="E_t"/></bpmn:process>
