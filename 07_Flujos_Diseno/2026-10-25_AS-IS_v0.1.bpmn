<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="AS_IS_Torvesa" targetNamespace="https://github.com/l333x/Tesis_Torvesa" exporter="IA de Diego (Claude)" exporterVersion="0.1">
<!-- AS-IS v0.1 (25-oct-2026): borrador SIN VALIDAR EN CAMPO. Fuente: Informe Final del 22-jul (antecedente propio). -->
<bpmn:collaboration id="Colab">
<bpmn:participant id="P_cli" name="Cliente" processRef="Proc_cli"/>
<bpmn:participant id="P_tor" name="Constructora Torvesa" processRef="Proc_tor"/>
<bpmn:messageFlow id="M0" name="Mensaje" sourceRef="T_esc" targetRef="S_msg"/><bpmn:messageFlow id="M1" name="Cotización" sourceRef="T_env" targetRef="T_rev"/>
</bpmn:collaboration>
<bpmn:process id="Proc_cli" isExecutable="false"><bpmn:startEvent id="S_cli" name="Necesita una obra"></bpmn:startEvent><bpmn:task id="T_esc" name="Escribe al WhatsApp personal de un socio o ingeniero, o por redes"></bpmn:task><bpmn:task id="T_rev" name="Revisa la cotización"></bpmn:task><bpmn:exclusiveGateway id="G_acp" name="¿Acepta?"></bpmn:exclusiveGateway><bpmn:endEvent id="E_si" name="Firma el contrato"></bpmn:endEvent><bpmn:endEvent id="E_no" name="Se va con otra empresa"></bpmn:endEvent><bpmn:sequenceFlow id="F0" sourceRef="S_cli" targetRef="T_esc" name=""/><bpmn:sequenceFlow id="F1" sourceRef="T_rev" targetRef="G_acp" name=""/><bpmn:sequenceFlow id="F2" sourceRef="G_acp" targetRef="E_si" name="Sí"/><bpmn:sequenceFlow id="F3" sourceRef="G_acp" targetRef="E_no" name="No o no responde"/></bpmn:process>
<bpmn:process id="Proc_tor" isExecutable="false"><bpmn:laneSet id="LS"><bpmn:lane id="L_rec" name="Recibe el mensaje (socio o ingeniero)"><bpmn:flowNodeRef>S_msg</bpmn:flowNodeRef><bpmn:flowNodeRef>T_lee</bpmn:flowNodeRef><bpmn:flowNodeRef>G_pue</bpmn:flowNodeRef><bpmn:flowNodeRef>T_ree</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_ate" name="Atiende y cotiza (coordinador u otro)"><bpmn:flowNodeRef>T_con</bpmn:flowNodeRef><bpmn:flowNodeRef>T_cot</bpmn:flowNodeRef><bpmn:flowNodeRef>T_env</bpmn:flowNodeRef><bpmn:flowNodeRef>T_seg</bpmn:flowNodeRef><bpmn:flowNodeRef>E_fin</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="S_msg" name="Llega el mensaje"><bpmn:messageEventDefinition/></bpmn:startEvent><bpmn:task id="T_lee" name="Lee el mensaje cuando puede (está en obra)"></bpmn:task><bpmn:exclusiveGateway id="G_pue" name="¿Puede atenderlo?"></bpmn:exclusiveGateway><bpmn:task id="T_ree" name="Reenvía por WhatsApp a otra persona"></bpmn:task><bpmn:task id="T_con" name="Primer contacto: pide los datos de la obra"></bpmn:task><bpmn:task id="T_cot" name="Arma la cotización casi desde cero"></bpmn:task><bpmn:task id="T_env" name="Envía la cotización por WhatsApp o correo"></bpmn:task><bpmn:task id="T_seg" name="Hace seguimiento si se acuerda"></bpmn:task><bpmn:endEvent id="E_fin" name="Fin (nada queda registrado)"></bpmn:endEvent><bpmn:sequenceFlow id="F4" sourceRef="S_msg" targetRef="T_lee" name=""/><bpmn:sequenceFlow id="F5" sourceRef="T_lee" targetRef="G_pue" name=""/><bpmn:sequenceFlow id="F6" sourceRef="G_pue" targetRef="T_ree" name="No"/><bpmn:sequenceFlow id="F7" sourceRef="G_pue" targetRef="T_con" name="Sí"/><bpmn:sequenceFlow id="F8" sourceRef="T_ree" targetRef="T_con" name=""/><bpmn:sequenceFlow id="F9" sourceRef="T_con" targetRef="T_cot" name=""/><bpmn:sequenceFlow id="F10" sourceRef="T_cot" targetRef="T_env" name=""/><bpmn:sequenceFlow id="F11" sourceRef="T_env" targetRef="T_seg" name=""/><bpmn:sequenceFlow id="F12" sourceRef="T_seg" targetRef="E_fin" name=""/><bpmn:textAnnotation id="Nota"><bpmn:text>Si quien atiende falta o se va, el historial del cliente se queda en su celular</bpmn:text></bpmn:textAnnotation></bpmn:process>
<bpmndi:BPMNDiagram id="D1"><bpmndi:BPMNPlane id="Plano" bpmnElement="Colab"><bpmndi:BPMNShape id="P_cli_di" bpmnElement="P_cli" isHorizontal="true"><dc:Bounds x="0" y="0" width="1640" height="180"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="P_tor_di" bpmnElement="P_tor" isHorizontal="true"><dc:Bounds x="0" y="210" width="1640" height="340"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_rec_di" bpmnElement="L_rec" isHorizontal="true"><dc:Bounds x="30" y="210" width="1610" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_ate_di" bpmnElement="L_ate" isHorizontal="true"><dc:Bounds x="30" y="380" width="1610" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_cli_di" bpmnElement="S_cli"><dc:Bounds x="92" y="52" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_esc_di" bpmnElement="T_esc"><dc:Bounds x="218" y="30" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_rev_di" bpmnElement="T_rev"><dc:Bounds x="1068" y="30" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="G_acp_di" bpmnElement="G_acp"><dc:Bounds x="1285" y="45" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_si_di" bpmnElement="E_si"><dc:Bounds x="1412" y="52" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_no_di" bpmnElement="E_no"><dc:Bounds x="1412" y="122" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_msg_di" bpmnElement="S_msg"><dc:Bounds x="282" y="277" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_lee_di" bpmnElement="T_lee"><dc:Bounds x="388" y="255" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="G_pue_di" bpmnElement="G_pue"><dc:Bounds x="605" y="270" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_ree_di" bpmnElement="T_ree"><dc:Bounds x="708" y="255" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_con_di" bpmnElement="T_con"><dc:Bounds x="708" y="425" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_cot_di" bpmnElement="T_cot"><dc:Bounds x="888" y="425" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_env_di" bpmnElement="T_env"><dc:Bounds x="1068" y="425" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_seg_di" bpmnElement="T_seg"><dc:Bounds x="1248" y="425" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_fin_di" bpmnElement="E_fin"><dc:Bounds x="1472" y="447" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="F0_di" bpmnElement="F0"><di:waypoint x="128" y="70"/><di:waypoint x="218" y="70"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="1232" y="70"/><di:waypoint x="1285" y="70"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="1335" y="70"/><di:waypoint x="1412" y="70"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="1310" y="95"/><di:waypoint x="1310" y="140"/><di:waypoint x="1412" y="140"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="318" y="295"/><di:waypoint x="388" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="552" y="295"/><di:waypoint x="605" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="655" y="295"/><di:waypoint x="708" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="630" y="320"/><di:waypoint x="630" y="465"/><di:waypoint x="708" y="465"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="790" y="335"/><di:waypoint x="790" y="425"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="872" y="465"/><di:waypoint x="888" y="465"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1052" y="465"/><di:waypoint x="1068" y="465"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1232" y="465"/><di:waypoint x="1248" y="465"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1412" y="465"/><di:waypoint x="1472" y="465"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M0_di" bpmnElement="M0"><di:waypoint x="300" y="110"/><di:waypoint x="300" y="277"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="M1_di" bpmnElement="M1"><di:waypoint x="1150" y="425"/><di:waypoint x="1150" y="110"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Nota_di" bpmnElement="Nota"><dc:Bounds x="740" y="520" width="480" height="24"/></bpmndi:BPMNShape></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
