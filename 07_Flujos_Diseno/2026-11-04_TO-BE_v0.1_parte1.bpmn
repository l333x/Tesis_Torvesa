<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="TO_BE_Torvesa" targetNamespace="https://github.com/l333x/Tesis_Torvesa" exporter="IA de Diego (Claude)" exporterVersion="0.1">
<!-- TO-BE v0.1 parte 1 (2-nov-2026): borrador sin validar con Torvesa. -->
<bpmn:collaboration id="Colab"><bpmn:participant id="P_cli" name="Cliente" processRef="Proc_P_cli"/><bpmn:participant id="P_tor" name="Torvesa con el sistema" processRef="Proc_P_tor"/><bpmn:messageFlow id="M3" name="Solicitud" sourceRef="T_form" targetRef="S_form"/><bpmn:messageFlow id="M4" name="Mensaje" sourceRef="T_wa" targetRef="S_wa"/><bpmn:messageFlow id="M12" name="Llamada o mensaje" sourceRef="T_con" targetRef="I_con"/><bpmn:textAnnotation id="Nota0"><bpmn:text>Por validar en campo: regla para elegir al responsable (turno, zona o tipo de obra). Hoy, en el MVP, el responsable es quien pulsa «Tomar».</bpmn:text></bpmn:textAnnotation></bpmn:collaboration>
<bpmn:process id="Proc_P_cli" isExecutable="false"><bpmn:startEvent id="S_cli" name="Necesita una obra"></bpmn:startEvent><bpmn:exclusiveGateway id="G_can" name="¿Por dónde escribe?"></bpmn:exclusiveGateway><bpmn:userTask id="T_form" name="Llena el formulario web y acepta el aviso de privacidad"><bpmn:documentation>RQ-18</bpmn:documentation></bpmn:userTask><bpmn:userTask id="T_wa" name="Escribe al WhatsApp o llama"></bpmn:userTask><bpmn:intermediateCatchEvent id="I_con" name="Recibe el primer contacto"><bpmn:messageEventDefinition id="MED1"/></bpmn:intermediateCatchEvent><bpmn:endEvent id="E_cli" name="Espera la cotización (parte 2)"></bpmn:endEvent><bpmn:sequenceFlow id="F0" name="" sourceRef="S_cli" targetRef="G_can"/><bpmn:sequenceFlow id="F1" name="Formulario" sourceRef="G_can" targetRef="T_form"/><bpmn:sequenceFlow id="F2" name="WhatsApp o teléfono" sourceRef="G_can" targetRef="T_wa"/><bpmn:sequenceFlow id="F16" name="" sourceRef="T_form" targetRef="I_con"/><bpmn:sequenceFlow id="F17" name="" sourceRef="T_wa" targetRef="I_con"/><bpmn:sequenceFlow id="F18" name="" sourceRef="I_con" targetRef="E_cli"/></bpmn:process><bpmn:process id="Proc_P_tor" isExecutable="false"><bpmn:laneSet id="LS_P_tor"><bpmn:lane id="L_coo" name="Coordinador comercial"><bpmn:flowNodeRef>S_wa</bpmn:flowNodeRef><bpmn:flowNodeRef>T_man</bpmn:flowNodeRef><bpmn:flowNodeRef>T_con</bpmn:flowNodeRef><bpmn:flowNodeRef>E_p3</bpmn:flowNodeRef><bpmn:flowNodeRef>T_mar</bpmn:flowNodeRef><bpmn:flowNodeRef>T_con_b</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_reg" name="Registro y alertas (TEAMSLASH)"><bpmn:flowNodeRef>S_form</bpmn:flowNodeRef><bpmn:flowNodeRef>T_reg</bpmn:flowNodeRef><bpmn:flowNodeRef>T_asi</bpmn:flowNodeRef><bpmn:flowNodeRef>T_ale</bpmn:flowNodeRef><bpmn:flowNodeRef>T_hor</bpmn:flowNodeRef><bpmn:flowNodeRef>E_tor</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_bov" name="Bóveda"><bpmn:flowNodeRef>T_fic</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_ver" name="Registro verificable"></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="S_wa" name="Le llega un WhatsApp o una llamada"><bpmn:messageEventDefinition id="MED2"/></bpmn:startEvent><bpmn:userTask id="T_man" name="Registrar la solicitud desde el celular"><bpmn:documentation>RQ-03 (≤ 1 min)</bpmn:documentation></bpmn:userTask><bpmn:userTask id="T_con" name="Abrir la ficha desde la alerta y contactar al cliente"><bpmn:documentation>RQ-02 · M1</bpmn:documentation></bpmn:userTask><bpmn:endEvent id="E_p3" name="Recordatorio y aviso (parte 3)"></bpmn:endEvent><bpmn:userTask id="T_mar" name="Marcar «En contacto»"><bpmn:documentation>RQ-05</bpmn:documentation></bpmn:userTask><bpmn:startEvent id="S_form" name="Llega el formulario"><bpmn:messageEventDefinition id="MED3"/></bpmn:startEvent><bpmn:serviceTask id="T_reg" name="Registrar la solicitud con código, canal y hora de ingreso"><bpmn:documentation>RQ-01 (≤ 5 s)</bpmn:documentation><bpmn:dataOutputAssociation id="DA_T_reg_0"><bpmn:targetRef>DS</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:serviceTask id="T_asi" name="Asignar un único responsable"><bpmn:documentation>RQ-04</bpmn:documentation><bpmn:dataOutputAssociation id="DA_T_asi_0"><bpmn:targetRef>DS</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:serviceTask id="T_ale" name="Enviar la alerta al celular con enlace a la ficha"><bpmn:documentation>RQ-02 (≤ 5 s)</bpmn:documentation></bpmn:serviceTask><bpmn:serviceTask id="T_hor" name="Guardar la hora de primer contacto"><bpmn:documentation>RQ-24 · M1</bpmn:documentation><bpmn:dataOutputAssociation id="DA_T_hor_0"><bpmn:targetRef>DS</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:endEvent id="E_tor" name="Pasa a la cotización (parte 2)"></bpmn:endEvent><bpmn:serviceTask id="T_fic" name="Crear o actualizar la ficha del cliente (CLI-0001)"><bpmn:documentation>RQ-09</bpmn:documentation></bpmn:serviceTask><bpmn:dataStoreReference id="DS" name="Registro de eventos con huella SHA-256 (solo agregar)"></bpmn:dataStoreReference><bpmn:boundaryEvent id="T_con_b" name="15 min sin contacto" attachedToRef="T_con" cancelActivity="false"><bpmn:timerEventDefinition id="TED4"/></bpmn:boundaryEvent><bpmn:sequenceFlow id="F5" name="" sourceRef="S_wa" targetRef="T_man"/><bpmn:sequenceFlow id="F6" name="" sourceRef="S_form" targetRef="T_reg"/><bpmn:sequenceFlow id="F7" name="" sourceRef="T_man" targetRef="T_reg"/><bpmn:sequenceFlow id="F8" name="" sourceRef="T_reg" targetRef="T_fic"/><bpmn:sequenceFlow id="F9" name="" sourceRef="T_fic" targetRef="T_asi"/><bpmn:sequenceFlow id="F10" name="" sourceRef="T_asi" targetRef="T_ale"/><bpmn:sequenceFlow id="F11" name="" sourceRef="T_ale" targetRef="T_con"/><bpmn:sequenceFlow id="F13" name="" sourceRef="T_con" targetRef="T_mar"/><bpmn:sequenceFlow id="F14" name="" sourceRef="T_mar" targetRef="T_hor"/><bpmn:sequenceFlow id="F15" name="" sourceRef="T_hor" targetRef="E_tor"/><bpmn:sequenceFlow id="F22" name="" sourceRef="T_con_b" targetRef="E_p3"/></bpmn:process>
